# systemd unit for the LTor web demo backend (ltor.maazi.de).
# Installed by deploy/remote-install.sh to /etc/systemd/system/ltor-backend.service
#
#   sudo systemctl status ltor-backend
#   sudo journalctl -u ltor-backend -f

[Unit]
Description=maazi.de | LTor web demo backend (WebSocket, 127.0.0.1:8646)
After=network.target

[Service]
Type=simple
# __USER__/__GROUP__ are replaced by remote-install.sh with the deploy user.
User=__USER__
Group=__GROUP__
WorkingDirectory=/var/www/ltor
ExecStart=/usr/bin/env node /var/www/ltor/server/index.mjs
Environment=NODE_ENV=production
Environment=LTOR_MODE=demo
Environment=LTOR_HOST=127.0.0.1
Environment=LTOR_PORT=8646
Environment=LTOR_MAX_SESSIONS=150
Environment=LTOR_ALLOWED_ORIGINS=https://ltor.maazi.de,http://ltor.maazi.de
Restart=always
RestartSec=3

# Hardening: the demo needs no disk writes and no outbound network.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=512M
CPUQuota=80%

[Install]
WantedBy=multi-user.target
